# CISIA Santé — copier vers .env puis remplacer les secrets
# cp .env.example .env

# Sécurité (OBLIGATOIRE : générer des valeurs uniques, jamais committer .env)
# Exemple : python -c "import secrets; print(secrets.token_urlsafe(48))"
CISIA_SESSION_SECRET=
ML_API_KEY=

# Webapp
CISIA_AUTH=1
CISIA_LLM=0
WEBAPP_PORT=8000

# Ré-entraînement automatique (conteneur retrain)
RETRAIN_INTERVAL_SECONDS=86400
RETRAIN_OPTUNA=1
OPTUNA_TRIALS=25

# Surveillance rechargement modèles (secondes)
MODEL_WATCH_INTERVAL=45

# FHIR sandbox (ingestion optionnelle)
FHIR_BASE_URL=https://hapi.fhir.org/baseR4
